#  {% endfor %}



template:
  - switch:

    - name: "Hot tub & wall Drips"
      default_entity_id: switch.sprinkler_valve_01
      unique_id: valve_id_01
      optimistic: true
      turn_on:
         - action: system_log.write
           data:
             message: "Turned on valve #01 Hot tub & wall Drips"
      turn_off:
         - action: system_log.write
           data:
             message: "Turned off valve #01 Hot tub & wall Drips"

    - name: "02) [Capped] Horseshoe Sprinklers"
      default_entity_id: switch.sprinkler_valve_02
