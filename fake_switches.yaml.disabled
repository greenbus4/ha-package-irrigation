#  {% 
#    for v in states.switch
#    |selectattr('entity_id', 'search', 'sprinkler_valve_\d\d$')
#    | sort(attribute='entity_id')
#  %}
#  {%- set count = v.entity_id[-2:] %}
#      - name: "{{ v.attributes.friendly_name }}"
#        default_entity_id: {{ v.entity_id }}
#        unique_id: valve_id_{{ count }}
#        optimistic: true
#        turn_on:
#           - action: system_log.write
#             data:
