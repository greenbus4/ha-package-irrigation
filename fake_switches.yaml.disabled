  - sensor:
    - name: Water FLow
      default_entity_id: sensor.irrigation_water_monitor_flow
      unique_id: irrigation_water_monitor_flow_id
      state: 0.0
      state_class: measurement
      unit_of_measurement: gal/min
      device_class: volume_flow_rate

    - name: Water Pressure
      default_entity_id: sensor.irrigation_water_monitor_water_pressure
      state: 45.5
      state_class: measurement
      unit_of_measurement: psi
      device_class: pressure
      icon: mdi:gauge


  - select:
    - name: Daily Irrigation
      default_entity_id: select.daily_irrigation
      unique_id: select_daily_irrigation_id
      state: "none"
      options: "{{ ['none','hose'] }}"

    - name: Monthly Irrigation
      default_entity_id: select.monthly_irrigation
      unique_id: select_monthly_irrigation_id
      state: "none"
      options: "{{ ['none','hose'] }}"
